# Razorpay Test Mode credentials (get from https://dashboard.razorpay.com/app/keys after switching to Test Mode)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# App
DATABASE_URL=sqlite:///./recoverai.db
LLM_MODE=stub          # stub | anthropic | groq
ANTHROPIC_API_KEY=     # required when LLM_MODE=anthropic
ANTHROPIC_MODEL=claude-3-5-haiku-latest
GROQ_API_KEY=          # required when LLM_MODE=groq (free at console.groq.com)
GROQ_MODEL=llama-3.1-8b-instant   # or llama-3.1-70b-versatile — check console.groq.com/docs/models
LOG_LEVEL=INFO

# Escalation destination (optional; Slack incoming webhook URL)
ESCALATION_WEBHOOK_URL=

# ROI accounting knobs (defaults are reasonable; override to match your rates)
COST_PER_LLM_DECISION_INR=0.05
COST_PER_PAYMENT_LINK_INR=0.50
COST_PER_SIMULATED_ACTION_INR=0.01
